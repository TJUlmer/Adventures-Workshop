# Copy to .env.local and fill in from your Supabase project settings.
# Sharing switches itself off when these are absent, so a clone without them
# still runs — see src/lib/cloud/config.ts.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Private draft storage is a separate, default-off rollout from publishing.
# off: local drafts only; opt-in: signed-in people choose per browser;
# cohort: internal ids plus a stable percentage; on: every permanent account.
VITE_CLOUD_DRAFTS_ROLLOUT=off
VITE_CLOUD_DRAFTS_INTERNAL_USER_IDS=
VITE_CLOUD_DRAFTS_COHORT_PERCENT=0
